# VideoSquash environment template
# Copy this file to the appropriate `.env` file(s) for your setup.

# Backend
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
USE_NVENC=true
UPLOAD_RATE_LIMIT=5/minute
STATUS_RATE_LIMIT=30/minute
DOWNLOAD_RATE_LIMIT=5/minute

# Frontend
# Use `/api` when running through the Vite proxy in local development.
# Use `http://localhost:8000/api` or your deployed backend URL when running the frontend separately.
VITE_API_BASE=/api
